{
  "manifest_version": 3,
  "name": "Chrome Hello Lock",
  "version": "0.5.0",
  "description": "A local privacy guard for your Chrome profile. Unlock with Windows Hello.",
  "key": "",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Chrome Hello Lock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "settings.html",
  "commands": {
    "lock-profile": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Lock this Chrome profile"
    }
  }
}
